# ─────────────────────────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.globalcodio.ai
NEXT_PUBLIC_SIGN_IN_URL=https://app.globalcodio.ai/login
# Origin of the platform app. /platform-privacy and /platform-terms fetch the
# canonical legal documents from here at build/revalidate time; if it is wrong
# those two pages fall back to a pointer instead of the document text.
NEXT_PUBLIC_PLATFORM_URL=https://app.globalcodio.ai
NEXT_PUBLIC_SUPPORT_EMAIL=info@globalcodio.ai
NEXT_PUBLIC_TWITTER_HANDLE=@globalcodio

# ─────────────────────────────────────────────────────────────────────────────
# Analytics (OPTIONAL - leave blank to keep the site tracker-free)
# When set, the consent framework activates: the cookie banner appears and
# Google Analytics loads ONLY after the visitor opts in (Google Consent Mode
# v2, default denied). Leave empty and no analytics scripts or cookies load.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Email (Resend)
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
# Until domain verified at resend.com/domains, use: GlobalCodio Contact <onboarding@resend.dev>
# After domain verified, change to: GlobalCodio Contact <info@globalcodio.ai>
RESEND_FROM_EMAIL=GlobalCodio Contact <onboarding@resend.dev>
CONTACT_TO_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────────────
API_PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# Sanity - project config (safe to expose, prefixed NEXT_PUBLIC_)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-06-01

# ─────────────────────────────────────────────────────────────────────────────
# Sanity - write token (Editor role, server-side only, NEVER prefix NEXT_PUBLIC_)
# Get from: https://www.sanity.io/manage → your project → API → Tokens → Add API token
# ─────────────────────────────────────────────────────────────────────────────
SANITY_API_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# MCP / Sanity Studio tooling
# Used in .mcp.json - update that file manually when these change
# SANITY_PROJECT_ID=        (same value as NEXT_PUBLIC_SANITY_PROJECT_ID)
# SANITY_DATASET=           (same value as NEXT_PUBLIC_SANITY_DATASET)
# SANITY_API_TOKEN=         (same token as above, or a separate MCP-scoped token)
# ─────────────────────────────────────────────────────────────────────────────
